# Copy to .env.local and fill in. Never commit .env.local.
#
# On Vercel, set these under Project Settings -> Environment Variables.
# Paste real secrets there and locally only — they should never appear in git,
# in a chat window, or in a screenshot.

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Use the *pooled* connection string, and make sure it ends in /fitness
# (not /neondb) so this app gets its own database.
#
# FITNESS_DATABASE_URL takes precedence over DATABASE_URL. That exists because
# Vercel's Neon integration installs DATABASE_URL as a *managed* variable which
# cannot be edited in the dashboard and points at the project's default
# database. Setting FITNESS_DATABASE_URL redirects this app without having to
# disconnect the integration.
#
# Locally, either name works — set just one.
FITNESS_DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/fitness?sslmode=require"
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Session gate
# ---------------------------------------------------------------------------
# The password you type to get in.
APP_PASSWORD="choose-a-strong-passphrase"

# Signs the session cookie. Minimum 32 characters.
# Generate:  openssl rand -base64 32
# Rotating this immediately signs you out everywhere.
SESSION_SECRET="replace-with-32-plus-random-characters"

# ---------------------------------------------------------------------------
# Claude coach (Phase 4 — optional)
# ---------------------------------------------------------------------------
# From console.anthropic.com. Billed separately from a Claude subscription.
# The app runs fine without this; the coach stays switched off.
ANTHROPIC_API_KEY=""

# Set to "true" to turn the coach on once the key above is populated.
FEATURE_COACH="false"
